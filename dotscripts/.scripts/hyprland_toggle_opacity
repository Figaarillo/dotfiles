#!/usr/bin/env bash

# Read by ~/.config/hypr/configs/cleanmode.lua on every config load
FLAG="/tmp/hypr_cleanmode"

if [ -f "$FLAG" ]; then
    rm "$FLAG"
    hyprctl reload config-only
    notify-send -a hyprland "Clean mode" "Off"
else
    touch "$FLAG"
    hyprctl reload config-only
    notify-send -a hyprland "Clean mode" "On"
fi
