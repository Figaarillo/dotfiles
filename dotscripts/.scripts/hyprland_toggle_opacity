#!/usr/bin/env bash

# Read by ~/.config/hypr/configs/cleanmode.lua on every config load,
# and by the quickshell bar/island (Theme.qml) to switch to solid glass
FLAG="/tmp/hypr_cleanmode"

if [ -f "$FLAG" ]; then
    rm "$FLAG"
    state="Off"
    clean=false
else
    touch "$FLAG"
    state="On"
    clean=true
fi

hyprctl reload config-only
qs ipc call theme setClean "$clean" >/dev/null
notify-send -a hyprland "Clean mode" "$state"
