#!/usr/bin/env bash

# Read by ~/.config/hypr/configs/cleanmode.lua on every config load,
# and by launch_waybar / launch_swaync to pick the solid (no blur) style
FLAG="/tmp/hypr_cleanmode"

if [ -f "$FLAG" ]; then
    rm "$FLAG"
    state="Off"
else
    touch "$FLAG"
    state="On"
fi

hyprctl reload config-only
# swaync first: waybar's notification module subscribes to it on start
systemctl --user restart swaync
~/.config/scripts/launch_waybar
notify-send -a hyprland "Clean mode" "$state"
