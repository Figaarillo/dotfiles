#!/usr/bin/bash
# Wallpaper cycling: expand cycle | cycler
# Used by waybar's wallpaper pill and SUPER + [ / ]
TEMP=/tmp/current_wall

files=(~/Pictures/Wallpapers/*)

scripts=~/.scripts

change() {
  index=$(cat $TEMP 2>/dev/null || echo 0)
  index=$(( (index + $1 + ${#files[@]}) % ${#files[@]} ))
  echo $index >$TEMP
  $scripts/wall "${files[$index]}"
}

case "$1" in
"cycle")
  change 1
  ;;
"cycler")
  change -1
  ;;
esac
