#!/usr/bin/env bash

state=$(hyprctl getoption animations:enabled | awk '/^(bool|int):/{print $2}')

if [ "$state" = "true" ] || [ "$state" = "1" ]; then
    hyprctl eval 'hl.config({ animations = { enabled = false } })'
    notify-send -a hyprland "Animations" "Disabled"
else
    hyprctl eval 'hl.config({ animations = { enabled = true } })'
    notify-send -a hyprland "Animations" "Enabled"
fi
